# Compiled binaries
bin/*
*.o

# Runtime logs
logs/*
!logs/.gitkeep

# Uploaded files
storage/*
!storage/.gitkeep

# Debug files
core
core.*

# Editor files
.vscode/
.idea/

# OS files
.DS_Store

# Vim swap and backup files
*.swp
*.swo
*~

# Downloaded files
downloads/*
!downloads/.gitkeep

# Python cache files
__pycache__/
*.py[cod]
